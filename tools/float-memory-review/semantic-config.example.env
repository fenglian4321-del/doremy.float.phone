# Ombre server only. Blank fields require explicit operator configuration.
# These are not NEXT_PUBLIC variables; do not paste real credentials into docs.
FLOAT_MEMORY_LATENT_ENABLED=true
FLOAT_MEMORY_LATENT_MODE=semantic-hybrid-v1
FLOAT_LATENT_EMBED_ENDPOINT=
FLOAT_LATENT_EMBED_MODEL=
FLOAT_LATENT_EMBED_DIMENSIONS=
# Calibrate for this model/corpus; there is deliberately no copied default.
FLOAT_LATENT_EMBED_HIT_FLOOR=
# Variable NAME, not a key. Can explicitly reuse the native provider credential
# loaded by FLOAT_MODEL_ENV_PATH; no copy of that secret is made into this file.
FLOAT_LATENT_EMBED_API_KEY_ENV=OMBRE_EMBED_API_KEY
FLOAT_LATENT_EMBED_REVISION=1
# Optional exact query prefix; omitted uses upstream's model-specific default.
# FLOAT_LATENT_EMBED_QUERY_PREFIX=
# Only synthetic/local HTTP embeddings; HTTPS is the production default.
FLOAT_LATENT_EMBED_ALLOW_LOCAL_HTTP=false
# Preserve the already-deployed private provider configuration.
FLOAT_MODEL_ENV_PATH=/app/buckets/.float-model.env
