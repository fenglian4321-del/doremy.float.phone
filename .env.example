# 自部署默认推荐开启：跳过作者官方账号/激活码系统，使用本地单机账号。
# 作者自己的 Netlify 链接版不要设置这个变量。
NEXT_PUBLIC_SELF_HOSTED_MODE=true

# 私人共享记忆。基础服务可浏览/搜索；安装下述扩展后可自动写入、纠错和管理。
# 凭据仅在服务端使用，不加 NEXT_PUBLIC_ 前缀。
# 指向自有心潮部署里的 Ombre Brain 服务根地址，不是心潮 /mcp 或公开可视化网站。
# 不填则入口显示“尚未配置”，不会读取其他记忆源。
FLOAT_SHARED_MEMORY_OMBRE_URL=
FLOAT_SHARED_MEMORY_OMBRE_PASSWORD=
# 单独随机生成至少 32 字符的 Float 共享记忆访问口令，勿复用上面的 Ombre 密码。
# 在 Float 记忆设置页面输入；口令不持久存储，验证后使用 7 天 HttpOnly 站点会话。
FLOAT_SHARED_MEMORY_ACCESS_TOKEN=
# 可选：仅在 Ombre 镜像安装 tools/float-memory-review 扩展后填写，
# 与 Ombre 侧 FLOAT_REVIEW_SERVICE_TOKEN 相同；至少 32 字符，仅服务端使用。
# 未填写/扩展不兼容时不开放写入和管理，原只读浏览仍保留。
FLOAT_SHARED_MEMORY_REVIEW_TOKEN=
# Ombre 容器的可选派生召回开关（不是 Float 前端环境变量）：
# FLOAT_MEMORY_LATENT_ENABLED=true
# 默认词面/图谱。可显式配置 semantic-hybrid-v1 开启 embedding 语义检索；
# 所有配置仅在 Ombre 服务器，详见 tools/float-memory-review/semantic-config.example.env。
# 默认仅 HTTPS；同一受控 Docker 网络内部用 HTTP 时才显式设 true。
FLOAT_SHARED_MEMORY_ALLOW_HTTP=false
# 反向代理部署时填 Float 自身的 HTTPS 根地址，供同源检查与安全会话使用。
# 不是 Ombre 地址；不信任浏览器传入的 Host / X-Forwarded-* 代替此配置。
FLOAT_SHARED_MEMORY_PUBLIC_ORIGIN=

# 可选 Codex 固定只读工具。独立服务端口令，不是模型 key，也不是上面的本人访问口令。
# 服务端网关和 Next 必须处于能通过受控地址互通的网络；网关默认只监听本机。
FLOAT_CODEX_GATEWAY_URL=
FLOAT_CODEX_GATEWAY_TOKEN=
FLOAT_CODEX_GATEWAY_ALLOW_HTTP=false
# 网关进程的独立配置见 tools/float-codex-gateway/example.env，勿加 NEXT_PUBLIC_。

# 可选：如果你要启用自己的 Supabase 云端功能，请填写自己的项目，不要使用作者的项目。
# 不要批量执行 docs/*.sql：按功能文档选择对应脚本。个人推送/生活日程云使用\n# docs/personal-push-supabase.sql，且必须部署到专用个人项目；旧版 docs/push-supabase.sql\n# 仅供仍使用站点共享推送的旧部署维护。特调使用独立项目和 docs/mixology-supabase.sql。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 独家特调（酒材页 / 配方页）专用的独立 Supabase 项目。特调的表、RPC 与全部读写只认
# 这两个变量，不会回退到上面的主库；不填就等于特调云端未开张。
# 需要先在这个项目的 SQL Editor 执行 docs/mixology-supabase.sql。
MIXOLOGY_SUPABASE_URL=
MIXOLOGY_SUPABASE_SERVICE_ROLE_KEY=

# 可选：现实桥“邮件自动执行”实验模式。先在 Resend 验证自己的发信域名，
# 再配置 API Key 和该域名下的发件地址。验证码密钥建议使用独立随机长字符串。
RESEND_API_KEY=
REALITY_BRIDGE_EMAIL_FROM="Float Reality Bridge <bridge@your-domain.example>"
SHORTCUT_EMAIL_VERIFICATION_SECRET=
# 可选：账号门禁签名密钥。启用账号系统时建议设置为随机长字符串。
ACCOUNT_GATE_SECRET=

# 可选：成年审核/激活码后台管理密钥。
VERIFY_ADMIN_KEY=

# 可选：应用市场审核后台密钥。不填时会回退使用 VERIFY_ADMIN_KEY。
APP_MARKET_ADMIN_KEY=

# 可选：启用便签墙实时刷新才需要。注意 NEXT_PUBLIC_* 会公开到浏览器，不要放 service_role。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 可选：第三方能力的服务端兜底 key。一般不用填——用户可在应用内自行填写
# （Tripo 在世界搭建界面，ImgBB 在生图/图床设置）。
TRIPO_API_KEY=
IMGBB_API_KEY=
WEIXIN_PROXY=
NEXT_PUBLIC_IMAGE_GEN_PROXY_URL=
# 可选：网易云音乐 API（NeteaseCloudMusicApi 兼容实例）。留空时在线音乐功能隐藏，
# 用户也可在音乐 APP 设置里自行填写。请部署你自己的实例，不要使用他人的。
NEXT_PUBLIC_DEFAULT_NETEASE_API_BASE=
# 可选：仅当你更换过默认音乐 API 地址时需要。旧地址填这里（逗号分隔），
# 老用户浏览器里存的旧地址会自动迁移到当前默认。
NEXT_PUBLIC_LEGACY_NETEASE_API_BASES=
NEXT_PUBLIC_NETEASE_REAL_IP=

# 心潮独立App只读连接（令牌仅服务端；不加NEXT_PUBLIC_）。默认空，不改变心潮现有配置。
FLOAT_XINCHAO_URL=
DYNAMIC_MIND_TOKEN=
FLOAT_XINCHAO_ALLOW_HTTP=false
# 仅部署端比对实际4.3.0源码与文档记录一致后，填4.3.0-2abe7fa9；留空拒绝远程访问。
FLOAT_XINCHAO_REST_CONTRACT=
